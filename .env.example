# Public URL of the PocketBase API, used by the browser (client components).
# In local dev this is the PocketBase dev server; in production it is your public API origin.
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Internal URL used for server-side rendering / data fetching inside the Docker network.
# Falls back to NEXT_PUBLIC_POCKETBASE_URL when unset (e.g. local `npm run dev`).
POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090

# Canonical site URL, used for SEO metadata, sitemap and RSS absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
